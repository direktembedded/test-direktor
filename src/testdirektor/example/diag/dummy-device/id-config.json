{
    "module": "robottestexecutor.config.DefaultIdentification",
    "implementation": "DefaultIdentification",
    "identifiers": [
                {
                    "key": "serial",
                    "name": "Serial No",
                    "match": "\\d*"
                },
                {
                    "key": "model",
                    "name": "Model",
                    "match": "Model[ABC]"
                },
                {
                    "key": "info",
                    "name": "Info",
                    "match": ".*"
                }
            ],
    "suites": {
            "path": "./",
            "selector": [
                {
                    "id": "model",
                    "match": "ModelA.*",
                    "suite": "ModelA-Suite.robot",
                    "instruction": {
                        "text": "Press Start to begin testing ModelA"
                    }
                },
                {
                    "id": "model",
                    "match": "ModelB",
                    "suite": "ModelB-Suite.robot",
                    "instruction": {
                        "text": "Press Start to begin testing ModelB"
                    }
                },
                {
                    "id": "model",
                    "match": "ModelC.*",
                    "suite": "ModelC-Suite.robot",
                    "instruction": {
                        "text": "Press Start to begin testing ModelC"
                    }
                }
            ]
        }
}
